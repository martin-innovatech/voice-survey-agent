# Postgres connection used by API and migration tasks
DATABASE_URL=postgresql://voice:voice@localhost:5433/voice_survey

# API runtime
PORT=3000
HOST=0.0.0.0
USE_IN_MEMORY_STORE=false

# OpenAI (optional, for AI summarization/report generation in next step)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_SUMMARY_ENABLED=false

# Web app -> API base URL
VITE_API_BASE_URL=http://localhost:3000
