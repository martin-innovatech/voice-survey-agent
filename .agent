name: voice-survey-agent
version: 0.5.0
status: poc

project:
  description: >
    Browser-based voice survey/interview platform with admin/user/reporting
    flows, organized as a monorepo with backend API kickoff in progress.

objectives:
  - Create and manage one or more surveys
  - Send invitations to recipients by email
  - Run browser-based voice interviews
  - Track participation and completion
  - Generate individual and overall written summaries

current_phase:
  name: Phase 2 - Backend MVP kickoff
  focus:
    - Fastify API scaffold in monorepo
    - Contract-aligned survey lifecycle endpoints
    - Postgres persistence and SQL migration foundation
    - Taskfile orchestration for local workflows
    - End-to-end testability and production hardening

stack:
  monorepo:
    - pnpm workspaces
    - Turborepo
  frontend:
    - React
    - TypeScript
    - Vite
    - CSS
  backend:
    - Fastify
    - TypeScript
    - Postgres-backed repository
    - In-memory fallback for local emergency use
  shared:
    - packages/shared TypeScript domain + API DTOs
  voice:
    - Browser Web Speech API (SpeechSynthesis + SpeechRecognition)
  integrations:
    - Email sending mocked as invitation status transitions

modules:
  admin:
    responsibilities:
      - Create/select surveys
      - Add questions
      - Add recipients by email
      - Send invitations
      - Finalize surveys
  participant:
    responsibilities:
      - Start/ask question
      - Answer by voice or text
      - Pause playback
      - Submit responses
  reporting:
    responsibilities:
      - Show completion metrics
      - Show individual summaries
      - Show overall summary

artifacts:
  - docs/data-model.md
  - docs/api/openapi.yaml
  - packages/shared/src/domain.ts
  - packages/shared/src/api.ts
  - apps/api/src/server.ts
  - apps/api/src/store.ts
  - apps/api/src/store.pg.ts
  - packages/db/migrations/0001_initial_schema.sql
  - Taskfile.yml
  - docker-compose.yml

milestones:
  - name: Browser UI scaffold
    status: completed
  - name: Admin/user/report views
    status: completed
  - name: Browser voice interaction (TTS/STT)
    status: completed
  - name: Survey finalization and summaries
    status: completed
  - name: Monorepo workspace structure
    status: completed
  - name: Shared domain model package
    status: completed
  - name: OpenAPI draft contract
    status: completed
  - name: Backend API scaffold
    status: completed
  - name: Backend persistence (Postgres baseline)
    status: completed
  - name: Taskfile orchestration baseline
    status: completed
  - name: End-to-end testing workflow
    status: in_progress
  - name: Real email provider integration
    status: planned
  - name: Production AI summarization
    status: planned
