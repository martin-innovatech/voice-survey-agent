# .agent

name: voice-survey-agent
version: 0.1.0
status: poc

project:
  description: >
    Browser-based voice survey/interview platform using
    speech-to-text and text-to-speech technologies.

objectives:
  - Create voice-driven survey experience
  - Enable admin management of surveys
  - Capture participant responses
  - Generate AI summaries and reports
  - Support browser-based interactions

current_phase:
  name: Phase 1 - Proof of Concept
  focus:
    - React frontend
    - Voice interaction
    - Survey workflow
    - Reporting prototype

stack:
  frontend:
    - React
    - Vite
    - TailwindCSS
    - shadcn/ui

  backend:
    - Supabase
    - PostgreSQL

  ai:
    - OpenAI Realtime API
    - OpenAI Speech-to-Text

  integrations:
    - Email provider

modules:
  admin:
    responsibilities:
      - Manage surveys
      - Manage participants
      - Track participation
      - Generate reports

  participant:
    responsibilities:
      - Start survey
      - Speak answers
      - Submit responses

  reporting:
    responsibilities:
      - Summarize responses
      - Aggregate statistics
      - Generate written reports

milestones:
  - name: Basic UI
    status: completed

  - name: Browser speech integration
    status: in_progress

  - name: Database integration
    status: planned

  - name: Email invitations
    status: planned

  - name: AI summarization
    status: planned

future_considerations:
  - Multi-language support
  - Real-time analytics
  - Conversation memory
  - CRM integrations
  - Enterprise authentication

