# .agent

name: voice-survey-agent
version: 0.2.0
status: poc

project:
  description: >
    Browser-based voice survey/interview platform using
    text-to-speech and speech-to-text with admin/user/reporting views.

objectives:
  - Create and manage one or more surveys
  - Send invitations to recipients by email
  - Run browser-based voice interviews
  - Track participation and completion
  - Generate individual and overall written summaries

current_phase:
  name: Phase 1 - Browser PoC
  focus:
    - React frontend workflow completion
    - Browser Web Speech API integration
    - Summary/reporting prototype

stack:
  frontend:
    - React
    - TypeScript
    - Vite
    - CSS
  voice:
    - Browser Web Speech API (SpeechSynthesis + SpeechRecognition)
  backend:
    - None (in-memory PoC state)
  integrations:
    - Email sending mocked as invitation status update

modules:
  admin:
    responsibilities:
      - Create/select survey
      - Add questions
      - Add recipients by email
      - Send invitations
      - Finalize survey
  participant:
    responsibilities:
      - Start/ask question
      - Answer by voice or text
      - Pause playback
      - Submit responses
  reporting:
    responsibilities:
      - Show completion metrics
      - Show individual summaries
      - Show overall summary

milestones:
  - name: Browser UI scaffold
    status: completed
  - name: Admin/user/report views
    status: completed
  - name: Browser voice interaction (TTS/STT)
    status: completed
  - name: Survey finalization and summaries
    status: completed
  - name: Backend persistence
    status: planned
  - name: Real email provider integration
    status: planned
  - name: Production AI summarization
    status: planned

future_considerations:
  - Multi-language support
  - Real-time analytics
  - Conversation memory
  - CRM integrations
  - Enterprise authentication
