{
  "name": "@voice-survey-agent/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @voice-survey-agent/db build && tsx watch src/server.ts",
    "build": "pnpm --filter @voice-survey-agent/db build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voice-survey-agent/db": "workspace:*",
    "@voice-survey-agent/shared": "workspace:*",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.15.6",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
