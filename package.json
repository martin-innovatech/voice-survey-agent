{
  "name": "voice-survey-agent-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "pnpm --filter @voice-survey-agent/web dev",
    "build:web": "pnpm --filter @voice-survey-agent/web build",
    "dev:api": "pnpm --filter @voice-survey-agent/api dev",
    "build:api": "pnpm --filter @voice-survey-agent/api build"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
